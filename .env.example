# Copy to .env.local for local work. Real values live ONLY in .env.local (git-ignored)
# and in Vercel > Project > Settings > Environment Variables. Never commit keys.

# Supabase (Project Settings > API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row-level security: used by jobs and the migration script, never in the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic key "axe-platform" (12-month expiry). Server only.
ANTHROPIC_API_KEY=

# Airtable PAT "axe-migration-readonly" (data.records:read, schema.bases:read, Axe base only). Server only.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appenZ6dsZo57DaJf

# Resend (transactional email). Server only.
RESEND_API_KEY=

# Sentry error tracking (optional until the Sentry project exists).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/*. Any long random string.
CRON_SECRET=

# Cloudflare R2 (listing photos). Server only, except the public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Google API key restricted to the Drive API (reads public photo folders)
GOOGLE_API_KEY=

# Website tracking (production website project only; leave empty elsewhere)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
